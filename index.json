{"version":3,"kind":"Article","sha256":"32690da671d9ccfec5b50aec398ed1dff2fa0806af5b380e5f6777bd34cf32a8","slug":"index","location":"/index.md","dependencies":[],"frontmatter":{"title":"x4c: Xarray for CESM","github":"https://github.com/NCAR/x4c","keywords":["xarray","CESM","climate","visualization","NCAR"],"source_url":"https://github.com/NCAR/x4c/blob/main/docsrc/index.md","edit_url":"https://github.com/NCAR/x4c/edit/main/docsrc/index.md","thumbnail":"/x4c/build/hero-sst-djf-a99e21c5043b6770fb1818007d68e95e.png","exports":[{"format":"md","filename":"index.md","url":"/x4c/build/index-696057a892e95b1a0ecad5cca3213a79.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"div","class":"x4c-hero","children":[{"type":"heading","depth":2,"children":[{"type":"text","value":"x4c","key":"REpib2omWR"}],"identifier":"x4c","label":"x4c","html_id":"x4c","implicit":true,"key":"ZUJcWKsdP2"},{"type":"paragraph","children":[{"type":"text","value":"An Xarray extension for CESM output. ","key":"qQMh8MwXM9"},{"type":"strong","children":[{"type":"text","value":"One line of code, one publication-ready climate map","key":"t0CciyCSrp"}],"key":"FlCdhgvES4"},{"type":"text","value":" — plus postprocessing, regridding, and diagnostics that already know what a CESM grid is.","key":"eooYbhczAN"}],"key":"FfRdQ7igPc"},{"type":"div","class":"x4c-install","children":[{"type":"span","class":"x4c-prompt","children":[{"type":"text","value":"$","key":"sxWHJln1ar"}],"key":"dOkOmB2g7u"},{"type":"text","value":" ","key":"H8pmTzB97K"},{"type":"span","children":[{"type":"text","value":"pip install x4c","key":"lCUWnhGDMS"}],"key":"DkNCkuisq3"},{"type":"text","value":" copy","key":"uiRdb6Sj9G"}],"key":"GL0bAlbplA"},{"type":"div","class":"x4c-cta","children":[{"type":"link","class":"x4c-btn-primary","url":"/ug-installation","children":[{"type":"text","value":"Get started","key":"HKJbh3M3mn"}],"urlSource":"ug-installation","dataUrl":"/ug-installation.json","internal":true,"protocol":"file","key":"dn5bk4KnKA"},{"type":"text","value":" ","key":"Ru204A22Va"},{"type":"link","class":"x4c-btn-ghost","url":"https://github.com/NCAR/x4c","children":[{"type":"text","value":"View on GitHub","key":"UXMdPKjGv2"}],"urlSource":"https://github.com/NCAR/x4c","error":true,"key":"IrZgmMGsb1"}],"key":"bEmMzInWCF"},{"type":"div","class":"x4c-hero-shot","children":[{"type":"image","url":"/x4c/build/hero-sst-djf-a99e21c5043b6770fb1818007d68e95e.png","alt":"Global sea surface temperature for December-January-February on a Robinson projection","key":"cdXNhxDeIV","urlSource":"assets/hero-sst-djf.png"},{"type":"div","class":"x4c-hero-code","children":[{"type":"inlineCode","value":"case.plot(\"SST:-12,1,2\")","key":"Zx3E1iwo7I"}],"key":"zjAsGRPxzO"}],"key":"Hyspbii5n6"}],"key":"tMCoGjvJtm"},{"type":"div","class":"x4c-section","children":[{"type":"heading","depth":3,"children":[{"type":"text","value":"Made with ","key":"TXY97VH9tY"},{"type":"inlineCode","value":".x.plot()","key":"kRijWq8eHp"}],"identifier":"made-with-x-plot","label":"Made with .x.plot()","html_id":"made-with-x-plot","implicit":true,"key":"Oqx9olBlQQ"},{"type":"paragraph","children":[{"type":"text","value":"Every figure below comes from a notebook in this documentation, and every one is reachable in a line or two. Click any to open the notebook that produced it.","key":"oEmMeqUXtX"}],"key":"LYXuIbjCmc"},{"type":"div","class":"x4c-gallery","children":[{"type":"code","lang":null,"meta":null,"value":"<a class=\"x4c-shot\" href=\"diags-variables\">\n  <img src=\"assets/gallery-isotopes.png\" alt=\"Four water-isotope maps\">\n  <div class=\"x4c-shot-meta\">\n    <div class=\"x4c-shot-title\">Water isotopes, annual mean</div>\n    <div class=\"x4c-shot-code\">da.x.regrid(2,2).x.annualize().mean('time').x.plot(…)</div>\n  </div>\n</a>\n\n<a class=\"x4c-shot\" href=\"core-analysis\">\n  <img src=\"assets/gallery-eof.png\" alt=\"First two EOFs of sea surface height\">\n  <div class=\"x4c-shot-meta\">\n    <div class=\"x4c-shot-title\">EOFs of sea-surface height</div>\n    <div class=\"x4c-shot-code\">m.x.plot(ax=axd[k], ssv=ssv, cmap='RdBu_r', …)</div>\n  </div>\n</a>\n\n<a class=\"x4c-shot\" href=\"diags-variables\">\n  <img src=\"assets/gallery-ocean-land.png\" alt=\"SST, SSS, mixed layer depth and land surface temperature\">\n  <div class=\"x4c-shot-meta\">\n    <div class=\"x4c-shot-title\">Ocean and land state</div>\n    <div class=\"x4c-shot-code\">ocean['SST'].x.regrid(2,2).mean('time').x.plot(…)</div>\n  </div>\n</a>\n\n<a class=\"x4c-shot\" href=\"diags-quickview\">\n  <img src=\"assets/gallery-quickview.png\" alt=\"Multi-panel diagnostics dashboard\">\n  <div class=\"x4c-shot-meta\">\n    <div class=\"x4c-shot-title\">A whole diagnostics dashboard</div>\n    <div class=\"x4c-shot-code\">case.quickview(timespan=(1, 10))</div>\n  </div>\n</a>\n\n<a class=\"x4c-shot\" href=\"core-regridding\">\n  <img src=\"assets/gallery-regrid.png\" alt=\"Native spectral element grid beside regridded output\">\n  <div class=\"x4c-shot-meta\">\n    <div class=\"x4c-shot-title\">Native grid to regular lat/lon</div>\n    <div class=\"x4c-shot-code\">ds.x.da.isel(time=0).x.regrid().x.plot(…)</div>\n  </div>\n</a>\n\n<a class=\"x4c-shot\" href=\"diags-new-vars\">\n  <img src=\"assets/gallery-precip.png\" alt=\"Annual mean precipitation\">\n  <div class=\"x4c-shot-meta\">\n    <div class=\"x4c-shot-title\">A variable you defined yourself</div>\n    <div class=\"x4c-shot-code\">case.calc('PRECT_MM|regrid(2,2):ann')</div>\n  </div>\n</a>\n\n<a class=\"x4c-shot\" href=\"core-visualization\">\n  <img src=\"assets/gallery-moc.png\" alt=\"Global meridional overturning circulation section\">\n  <div class=\"x4c-shot-meta\">\n    <div class=\"x4c-shot-title\">Vertical sections, same call</div>\n    <div class=\"x4c-shot-code\">moc.x.plot(levels=np.linspace(-20, 20, 21))</div>\n  </div>\n</a>\n\n<a class=\"x4c-shot\" href=\"core-visualization\">\n  <img src=\"assets/gallery-styles.png\" alt=\"Global mean surface temperature in a journal style\">\n  <div class=\"x4c-shot-meta\">\n    <div class=\"x4c-shot-title\">Publication styles, built in</div>\n    <div class=\"x4c-shot-code\">x4c.set_style('journal')</div>\n  </div>\n</a>","key":"TRVhzhpYdj"}],"key":"p354HB9XVh"}],"key":"Mtai1r5jdv"},{"type":"div","class":"x4c-section","children":[{"type":"heading","depth":3,"children":[{"type":"text","value":"What it does","key":"HDpharihbf"}],"identifier":"what-it-does","label":"What it does","html_id":"what-it-does","implicit":true,"key":"lVpNo2iGKP"},{"type":"div","class":"x4c-cards","children":[{"type":"code","lang":null,"meta":null,"value":"<a class=\"x4c-card\" href=\"ug-core\">\n  <div class=\"x4c-card-icon\">◈</div>\n  <h3>Core features</h3>\n  <p>The <code>.x</code> accessor knows where grid-cell areas live, how to find\n  lat/lon on an unstructured grid, and how the vertical coordinate is spaced.</p>\n</a>\n\n<a class=\"x4c-card\" href=\"ug-post\">\n  <div class=\"x4c-card-icon\">⇄</div>\n  <h3>Postprocessing</h3>\n  <p>Turn history files into timeseries with <code>History.gen_ts()</code> —\n  MPI-parallel splitting and merging over NCO.</p>\n</a>\n\n<a class=\"x4c-card\" href=\"ug-diags\">\n  <div class=\"x4c-card-icon\">◍</div>\n  <h3>Diagnostics</h3>\n  <p>Index a whole case with <code>Timeseries</code>, compute derived variables\n  on demand, and compress a processing chain into a single spell string.</p>\n</a>","key":"p7cTG8FYEM"}],"key":"apkOjshaes"}],"key":"jSszBTG3W9"},{"type":"heading","depth":3,"position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"children":[{"type":"text","value":"Getting started","position":{"start":{"line":141,"column":1},"end":{"line":141,"column":1}},"key":"b9mNoxDtwI"}],"identifier":"getting-started","label":"Getting started","html_id":"getting-started","implicit":true,"key":"sTkHG1uhLZ"},{"type":"paragraph","position":{"start":{"line":143,"column":1},"end":{"line":145,"column":1}},"children":[{"type":"inlineCode","value":"x4c","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"cNH0RtHvRV"},{"type":"text","value":" installs from PyPI. The regridding and pressure-level features additionally\nneed a few conda-only packages — see ","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"uLOvX6sx73"},{"type":"link","url":"/ug-installation","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"children":[{"type":"text","value":"Installation","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"n6rrprGiBb"}],"urlSource":"ug-installation.md","dataUrl":"/ug-installation.json","internal":true,"protocol":"file","key":"C4NCmx9pcR"},{"type":"text","value":" for the\nfull environment.","position":{"start":{"line":143,"column":1},"end":{"line":143,"column":1}},"key":"ivzHL2sHqx"}],"key":"hMBjpguGId"},{"type":"code","lang":"bash","value":"pip install x4c","position":{"start":{"line":147,"column":1},"end":{"line":149,"column":1}},"key":"sNiRS5j1w1"},{"type":"code","lang":"python","value":"import x4c\n\nds = x4c.load_dataset('b.e13.TS.nc')\nds.x.da.isel(time=0).x.plot(title='Surface temperature, month 1')","position":{"start":{"line":151,"column":1},"end":{"line":156,"column":1}},"key":"KSbiBV1s4j"}],"key":"VcprWcVA9O"}],"key":"Ke7f0olpTK"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"next":{"title":"Installation","short_title":"Installation","url":"/ug-installation","group":"x4c"}}},"domain":"http://localhost:3000"}