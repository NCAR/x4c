{"version":3,"kind":"Notebook","sha256":"a67114677590f8eb39a7c46752f9733904449bccb29bb71a4c56c22cee24bba2","slug":"core-annualization","location":"/notebooks/core-annualization.ipynb","dependencies":[],"frontmatter":{"title":"Annualization and seasonalization","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"github":"https://github.com/NCAR/x4c","keywords":["xarray","CESM","climate","visualization","NCAR"],"numbering":{"title":{"offset":1}},"source_url":"https://github.com/NCAR/x4c/blob/main/docsrc/notebooks/core-annualization.ipynb","edit_url":"https://github.com/NCAR/x4c/edit/main/docsrc/notebooks/core-annualization.ipynb","exports":[{"format":"ipynb","filename":"core-annualization.ipynb","url":"/x4c/build/core-annualization-9e819043e6afa724e19a6d2e9f5b4c50.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"inlineCode","value":".x.annualize()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jwvaidWiVL"},{"type":"text","value":" collapses a monthly series into annual or seasonal means, with\noptional day-length weighting.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"x5PCUMy3vm"}],"key":"hHIcc7nVMm"}],"key":"kdYtBE5yxd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nimport numpy as np\nimport xarray as xr\nimport matplotlib.pyplot as plt\nimport nc_time_axis  # registers the cftime axis converter for matplotlib\nimport x4c\n\nx4c.set_style('journal')\n\n# after set_style: it resets rcParams from matplotlibrc defaults, which includes the\n# backend, so assert the inline backend last or figures are never captured\n%matplotlib inline\n\n# The tutorial runs against a reduced copy of a real CESM case. It is published as a\n# GitHub Release asset rather than committed, so the first call downloads it into\n# ~/.cache/x4c (override with $X4C_CACHE_DIR) and later calls reuse it. Set\n# $X4C_SAMPLE_DIR to point at a copy you already have.\ncase_dir = x4c.fetch_sample_data(case='cesm1', verbose=False)\ncasename = os.path.basename(case_dir)\nprint('x4c', x4c.__version__)","key":"vA1y6ltwQQ"},{"type":"outputs","id":"UFVKEfK8LzEcElfDnVuCg","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"x4c 2026.6.11\n"},"children":[],"key":"UGsxQGflvZ"}],"key":"sj3GWrjOM0"}],"key":"FL92VGoD5O"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ts_path = os.path.join(\n    case_dir, 'atm', 'proc', 'tseries', 'month_1',\n    f'{casename}.cam.h0.TS.000101-000512.nc',\n)\nds = x4c.open_dataset(ts_path, comp='atm', grid='ne16np4', vn='TS', shift_time=True)\nda = ds.x.da\nprint(da.sizes)","key":"jxZdIzRfA5"},{"type":"outputs","id":"3EpEKsypqBTq971BgkVHe","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Frozen({'time': 60, 'ncol': 13826})\n"},"children":[],"key":"R7RcTJ6ZYL"}],"key":"mxnOtyMMFr"}],"key":"OkCkPVIsXJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Calendar-year means","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HZS8Q28WgC"}],"identifier":"calendar-year-means","label":"Calendar-year means","html_id":"calendar-year-means","implicit":true,"key":"ScrkjsdoVx"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"With no arguments, ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MwDtSIXSNf"},{"type":"inlineCode","value":"annualize","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mvb2c3aO1a"},{"type":"text","value":" averages each calendar year.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QRGvgZDtxk"}],"key":"c3OPfXDC7c"}],"key":"FlB7iRGBq5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ann = da.x.annualize()\nprint('months in ->', da.sizes['time'])\nprint('years out ->', ann.sizes['time'])\nprint(np.round(ann.x.gm.values, 3))","key":"UDzvmCEQ2z"},{"type":"outputs","id":"CpYp3x9Jwf5ZefltKio8W","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"months in -> 60\nyears out -> 5\n[296.395 296.354 296.508 296.504 296.215]\n"},"children":[],"key":"KVOXluA4oV"}],"key":"yxlor8QgWh"}],"key":"Z8ievpKt4u"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Day-length weighting","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Rg6D0Tf8wQ"}],"identifier":"day-length-weighting","label":"Day-length weighting","html_id":"day-length-weighting","implicit":true,"key":"okyvJUglHR"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Months are not the same length, so a plain mean over-weights February. Pass\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bROm6zaBCe"},{"type":"inlineCode","value":"days_weighted=True","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YUQWqZGgZc"},{"type":"text","value":" to weight each month by its number of days.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JNaFy1x0Cv"}],"key":"dB3U8hELIS"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"The weights are normalized over ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"ur1PTppUWL"},{"type":"strong","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"each output bin","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"bJfdPvL21j"}],"key":"N4RYa3Mix1"},{"type":"text","value":", not over the calendar year.\nThat distinction matters for wraparound seasons and for incomplete bins at the ends\nof a record — see the DJF example below.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"ZumDmAlnbK"}],"key":"cS17sHA4C3"}],"key":"mDtL4ukxZJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ann_w = da.x.annualize(days_weighted=True)\n\nprint('unweighted :', np.round(ann.x.gm.values, 4))\nprint('weighted   :', np.round(ann_w.x.gm.values, 4))\nprint('difference :', np.round((ann_w.x.gm - ann.x.gm).values, 4))","key":"Daqjfakgav"},{"type":"outputs","id":"bnXKfkTowPVTVO3VXrkRZ","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"unweighted : [296.3948 296.3538 296.5076 296.5039 296.2154]\nweighted   : [296.3999 296.3595 296.5133 296.5086 296.221 ]\ndifference : [0.0051 0.0057 0.0057 0.0047 0.0057]\n"},"children":[],"key":"WrM6CedA7Z"}],"key":"c4JcY7kxYy"}],"key":"XFIP0z40iI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Seasons","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ad4tjb5oL9"}],"identifier":"seasons","label":"Seasons","html_id":"seasons","implicit":true,"key":"Rj5okphvTG"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"inlineCode","value":"months","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EEukjUONyj"},{"type":"text","value":" takes a list of month numbers. A ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"b60MjoGEZD"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"negative","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hXOz4qLMyE"}],"key":"fiaSTmCZzS"},{"type":"text","value":" month means “take it from the\nprevious year”, which is how you express a season that straddles the year boundary.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CpIq0cFLHR"}],"key":"HC86cf7SIe"}],"key":"DkIyVS5cfZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"jja = da.x.annualize(months=[6, 7, 8])\nson = da.x.annualize(months=[9, 10, 11])\n\n# DJF: December belongs to the *previous* calendar year\ndjf = da.x.annualize(months=[-12, 1, 2])\n\nfor name, x in [('JJA', jja), ('SON', son), ('DJF', djf)]:\n    print(f'{name}: {x.sizes[\"time\"]} bins, global means {np.round(x.x.gm.values, 2)}')","key":"v158a5PbCC"},{"type":"outputs","id":"djao55eZVQmml6Ce8D1c_","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"JJA: 5 bins, global means [297.81 297.77 297.96 297.9  297.66]\nSON: 5 bins, global means [296.11 296.26 296.47 296.28 296.05]\nDJF: 6 bins, global means [295.16 295.08 295.09 295.42 294.97 294.68]\n"},"children":[],"key":"gAdDsIUihD"}],"key":"yN44WhTTmZ"}],"key":"sfYHAmjHBP"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"DJF returns one more bin than JJA over the same record: the first bin has only\nJanuary and February (no preceding December) and the last has only December. Those\npartial bins are averaged over what is actually present rather than being scaled as\nif the whole season were there.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QEQOIHJg9l"}],"key":"C0DARcfjUa"}],"key":"jFdDBFSqlR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"djf_w = da.x.annualize(months=[-12, 1, 2], days_weighted=True)\nprint('DJF time stamps :', [str(t)[:10] for t in djf.time.values])\nprint('DJF unweighted  :', np.round(djf.x.gm.values, 3))\nprint('DJF day-weighted:', np.round(djf_w.x.gm.values, 3))","key":"GvKVepKiPa"},{"type":"outputs","id":"gJeF_P5CCu4do2WnSpEWi","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"DJF time stamps : ['0001-02-28', '0002-02-28', '0003-02-28', '0004-02-28', '0005-02-28', '0006-02-28']\nDJF unweighted  : [295.156 295.079 295.09  295.424 294.965 294.676]\nDJF day-weighted: [295.14  295.069 295.078 295.415 294.956 294.676]\n"},"children":[],"key":"gPFate5mn9"}],"key":"n6dyd44N6f"}],"key":"AlNQEUy2RN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Climatology and anomalies","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sqSaHNM303"}],"identifier":"climatology-and-anomalies","label":"Climatology and anomalies","html_id":"climatology-and-anomalies","implicit":true,"key":"QKQFXGojVb"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"inlineCode","value":".x.climo","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NgvP3voYW5"},{"type":"text","value":" is the monthly climatology (12 bins); ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aKpgexzM2H"},{"type":"inlineCode","value":".x.anom","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Y7YKQxfLUI"},{"type":"text","value":" removes it, month by\nmonth.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rM18dB5p8y"}],"key":"El1KvnPfQw"}],"key":"a1yYe3Zu3k"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"climo = da.x.climo\nanom = da.x.anom\n\nprint('climo :', dict(climo.sizes), '| period', climo.attrs['climo_period'])\nprint('anom  :', dict(anom.sizes))","key":"Krqsybsp3b"},{"type":"outputs","id":"Ax0UAlxB0-xOGTvyFx6uW","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"climo : {'time': 12, 'ncol': 13826} | period (np.int64(1), np.int64(5))\nanom  : {'time': 60, 'ncol': 13826}\n"},"children":[],"key":"PJtjnrDJWc"}],"key":"q994C9S2Kx"}],"key":"jNuNR72vXj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"fig, axes = plt.subplots(1, 2, figsize=(11, 3.2))\naxes[0].plot(climo.time, climo.x.gm, marker='o')\naxes[0].set(xlabel='Month', ylabel='GMST [K]', title='Monthly climatology',\n            xticks=range(1, 13))\naxes[1].plot(anom.time, anom.x.gm, lw=1)\naxes[1].axhline(0, color='k', lw=0.8)\naxes[1].set(xlabel='Time', ylabel='GMST anomaly [K]', title='Monthly anomalies')\nfig.tight_layout()\nx4c.showfig(fig)","key":"QfCQnVIABL"},{"type":"outputs","id":"g-nLuyUMXS_T7pLJFMxN7","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4e4e7c277ac3ae6e65153332f67cf8f5","path":"/x4c/build/4e4e7c277ac3ae6e65153332f67cf8f5.png"},"text/plain":{"content":"<Figure size 1100x320 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"jJTrNGVdOv"}],"key":"jLIJ7r38Sy"}],"key":"uL7eJ7DmPu"}],"key":"gyOIHQJnhj"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Overview","url":"/core-overview","group":"x4c: Xarray for CESM"},"next":{"title":"Seasonal maps","url":"/core-annualization-seasonal","group":"x4c: Xarray for CESM"}}},"domain":"http://localhost:3000"}