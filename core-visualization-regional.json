{"version":3,"kind":"Notebook","sha256":"f200aa788403f9a6a461b878a5d94afee24d2c52e5d87ed42fa1411f2584550d","slug":"core-visualization-regional","location":"/notebooks/core-visualization-regional.ipynb","dependencies":[],"frontmatter":{"title":"Regional maps and saving figures","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"github":"https://github.com/NCAR/x4c","keywords":["xarray","CESM","climate","visualization","NCAR"],"numbering":{"title":{"offset":1}},"source_url":"https://github.com/NCAR/x4c/blob/main/docsrc/notebooks/core-visualization-regional.ipynb","edit_url":"https://github.com/NCAR/x4c/edit/main/docsrc/notebooks/core-visualization-regional.ipynb","exports":[{"format":"ipynb","filename":"core-visualization-regional.ipynb","url":"/x4c/build/core-visualization-r-b0c06df1251439b795e650bb4c128ba1.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"inlineCode","value":"latlon_range=[lat_min, lat_max, lon_min, lon_max]","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NroMVZDeX8"},{"type":"text","value":" crops the map to a box, and\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wlslA9r3OJ"},{"type":"inlineCode","value":"cbar_kwargs['ticks']","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"co2Mca9UMY"},{"type":"text","value":" sets the colorbar ticks independently of the contour ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lWBhyIJYMQ"},{"type":"inlineCode","value":"levels","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xcDsr8JmYZ"},{"type":"text","value":".\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vgOFmqfYBZ"},{"type":"inlineCode","value":"x4c.savefig()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pUwXRzOupg"},{"type":"text","value":" creates missing directories and trims whitespace on the way out.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Z93Gzx0uKa"}],"key":"a0XTAal6Fl"}],"key":"IJIiFGMZaS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nimport numpy as np\nimport xarray as xr\nimport matplotlib.pyplot as plt\nimport nc_time_axis  # registers the cftime axis converter for matplotlib\nimport x4c\n\nx4c.set_style('journal')\n\n# after set_style: it resets rcParams from matplotlibrc defaults, which includes the\n# backend, so assert the inline backend last or figures are never captured\n%matplotlib inline\n\n# The tutorial runs against a reduced copy of a real CESM case. It is published as a\n# GitHub Release asset rather than committed, so the first call downloads it into\n# ~/.cache/x4c (override with $X4C_CACHE_DIR) and later calls reuse it. Set\n# $X4C_SAMPLE_DIR to point at a copy you already have.\ncase_dir = x4c.fetch_sample_data(case='cesm1', verbose=False)\ncasename = os.path.basename(case_dir)\nprint('x4c', x4c.__version__)","key":"tU68qOZULH"},{"type":"outputs","id":"rcu0jU38KpXx09nVL-UZs","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"x4c 2026.6.11\n"},"children":[],"key":"u2aBPcWn0m"}],"key":"MUt6ucjnzI"}],"key":"efNGpXKkEv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"temp_path = os.path.join(\n    case_dir, 'ocn', 'proc', 'tseries', 'month_1',\n    f'{casename}.pop.h.TEMP.000101-000112.nc',\n)\nds_temp = x4c.open_dataset(temp_path, comp='ocn', grid='g16', vn='TEMP', shift_time=True)\nsst = ds_temp.x.da.isel(z_t=0).x.regrid().mean('time')\nsst.attrs[\"long_name\"] = \"Sea Surface Temperature\"","key":"eEkaddX63O"},{"type":"outputs","id":"4YGqUh8M3UbRZ0IzN6PvN","children":[],"key":"wvTfGM4Mtp"}],"key":"vTJ8GzJOwF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x4c.set_style('journal_spines', font_scale=1.2)\nfig, ax = sst.x.plot(\n    levels=np.linspace(5, 35, 21),\n    cbar_kwargs={'ticks': np.linspace(5, 35, 7)},\n    add_gridlines=True,\n    latlon_range=[-50, 50, 30, 160],\n    title='Sea-surface temperature (year 1, Indo-Pacific)',\n)\nx4c.showfig(fig)\nx4c.savefig(fig, './figs/SST_ann_regional.pdf')\nx4c.set_style('journal')  # restore","key":"MtTlSnJ5mC"},{"type":"outputs","id":"Og0mu0osbiRRNZoAY58T5","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"65ecd1bc02b13da066b171f5cb1c0903","path":"/x4c/build/65ecd1bc02b13da066b171f5cb1c0903.png"},"text/plain":{"content":"<Figure size 1000x300 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"NZmcnQNIRK"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Figure saved at: \"figs/SST_ann_regional.pdf\"\n"},"children":[],"key":"rFNO90Aj2P"}],"key":"QYD8vPhr4b"}],"key":"cuwlCoR2My"}],"key":"cI3wQeYiGA"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Contour levels, colormaps, gridlines","url":"/core-visualization-contour","group":"x4c: Xarray for CESM"},"next":{"title":"Vertical sections","url":"/core-visualization-vertical","group":"x4c: Xarray for CESM"}}},"domain":"http://localhost:3000"}